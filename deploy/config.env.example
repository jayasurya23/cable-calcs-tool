# Copy to config.env and edit. Sourced by provision.sh and deploy.sh.
# config.env is gitignored (it can hold the DB password).

# ── Names (ACR + Postgres names must be GLOBALLY unique) ──
export RG=cable-web-rg
export LOCATION=eastus2
export ACR=cablewebacr           # 5-50 lowercase alnum, globally unique
export APP=cable-web-castillo    # -> https://<APP>.azurewebsites.net (globally unique)
export PLAN=cable-web-plan
export IMAGE=cableweb:latest

# ── App Service plan ──
export PLAN_SKU=B1               # B1 (~$13/mo, 1.75GB) — bump to B2 for more RAM

# ── PostgreSQL Flexible Server ──
export PG_SERVER=cable-web-pg    # globally unique
export PG_SKU=Standard_B1ms      # cheapest burstable
export PG_TIER=Burstable
export PG_DB=cableweb
export PG_ADMIN=cableadmin
# Set a strong password here (or export PG_PASSWORD in your shell before running).
export PG_PASSWORD=

# ── App auth ──
# Start with "local" so you can sign in via /setup, then switch to "entra".
export AUTH_MODE=local
export ADMIN_EMAILS=            # comma-separated; these become admins in entra mode
export ENTRA_TENANT_ID=
export ENTRA_CLIENT_ID=
export ENTRA_CLIENT_SECRET=
export SESSION_TTL_HOURS=72
