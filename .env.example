# Copy to .env and adjust. .env is gitignored.

APP_NAME=Cable Web
DEBUG=false

# ── Authentication ─────────────────────────────────────────────
# "local"  = built-in accounts (first run creates the admin at /setup)
# "entra"  = Microsoft Entra ID (M365) sign-in — requires an app registration:
#   Azure Portal → Entra ID → App registrations → New registration
#     Redirect URI (Web): https://<your-host>/auth/callback
#     Certificates & secrets → New client secret
#     API permissions: Microsoft Graph → Delegated → User.Read
AUTH_MODE=local
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback
# Comma-separated emails that get the admin role on first sign-in (Entra mode)
ADMIN_EMAILS=
SESSION_TTL_HOURS=72
# Set true in production (HTTPS) so session cookies never travel over plain HTTP
COOKIE_SECURE=false

# ── Persistence ────────────────────────────────────────────────
# SQLite (standalone) by default; set for Azure SQL / Postgres instead:
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname
# Durable project/revision document storage root (defaults to ./data)
# DATA_DIR=/home/site/data

# Path to the shared desktop calc engines (defaults to ../Cable-Optimisation-app)
# ENGINE_DIR=/home/site/wwwroot/Cable-Optimisation-app

# Upload staging dir (defaults to ./uploads).
# UPLOAD_DIR=/home/site/uploads

# Comma-separated CORS origins ("*" during early dev).
CORS_ORIGINS=*
